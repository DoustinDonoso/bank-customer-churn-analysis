import pandas as pd

# --- Carga ---
df = pd.read_csv("Customer-Churn-Records.csv")

# --- Estadísticas ANTES de la limpieza ---
print("=== ANTES ===")
print("Filas, columnas:", df.shape)
print("Duplicados por CustomerId:", df.duplicated(subset=["CustomerId"]).sum())
print("Filas duplicadas completas:", df.duplicated().sum())
print("Nulos por columna:\n", df.isnull().sum())
print("Nulos totales:", df.isnull().sum().sum())
print("Saldos negativos:", (df["Balance"] < 0).sum())
print("Edades < 18:", (df["Age"] < 18).sum())
print("Edades > 100:", (df["Age"] > 100).sum())
print("Salarios negativos:", (df["EstimatedSalary"] < 0).sum())
print(df[["CreditScore", "Age", "Tenure", "Balance", "EstimatedSalary", "Exited"]].describe())

# --- Limpieza ---
df_clean = (
    df.drop_duplicates(subset=["CustomerId"], keep="first")
      .dropna()
      .loc[lambda x: x["Balance"] >= 0]
      .loc[lambda x: (x["Age"] >= 18) & (x["Age"] <= 100)]
      .loc[lambda x: x["EstimatedSalary"] >= 0]
      .copy()
)

# Categoría de saldo (cero / bajo / medio / alto, cortes sobre saldos > 0)
_pos = df_clean.loc[df_clean["Balance"] > 0, "Balance"]
_q1, _q2 = _pos.quantile(0.33), _pos.quantile(0.66)

def _cat_saldo(v):
    if v == 0:
        return "Cero"
    if v <= _q1:
        return "Bajo"
    if v <= _q2:
        return "Medio"
    return "Alto"

# Rangos de edad
df_clean["AgeGroup"] = pd.cut(
    df_clean["Age"],
    bins=[17, 30, 40, 50, 60, 100],
    labels=["18-30", "31-40", "41-50", "51-60", "61+"],
)
df_clean["BalanceCategory"] = df_clean["Balance"].map(_cat_saldo)

# --- Estadísticas DESPUÉS de la limpieza ---
print("\n=== DESPUÉS ===")
print("Filas, columnas:", df_clean.shape)
print("Filas eliminadas:", len(df) - len(df_clean))
print("Duplicados por CustomerId:", df_clean.duplicated(subset=["CustomerId"]).sum())
print("Nulos totales:", df_clean.isnull().sum().sum())
print("Saldos negativos:", (df_clean["Balance"] < 0).sum())
print("Edades fuera de 18-100:", ((df_clean["Age"] < 18) | (df_clean["Age"] > 100)).sum())
print(df_clean[["CreditScore", "Age", "Tenure", "Balance", "EstimatedSalary", "Exited"]].describe())
print("\nAgeGroup:\n", df_clean["AgeGroup"].value_counts().sort_index())
print("\nBalanceCategory:\n", df_clean["BalanceCategory"].value_counts())
print("\nExited:\n", df_clean["Exited"].value_counts())

df_clean.to_csv("Customer-Churn-Records-clean.csv", index=False)
print("\nGuardado: Customer-Churn-Records-clean.csv")